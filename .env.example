# ──────────────────────────────────────────────────────────────────────────
# compose.yaml 용 환경변수 **템플릿**. 이 파일은 커밋한다 (실제 값은 넣지 않는다).
#
# 사용법
#   cp .env.example .env
#   그 다음 .env 의 CHANGE_ME 를 실제 값으로 바꾼다. (.env 는 .gitignore 로 막혀 있다)
#
# docker compose 는 같은 디렉터리의 .env 를 자동으로 읽어 compose.yaml 의 ${...} 를 채운다.
# 값은 application-secret.yaml 과 같다 — 그 파일은 컨테이너 안으로 들어가지 않으므로(.dockerignore) 여기에 따로 둔다.
# ──────────────────────────────────────────────────────────────────────────

# compose 의 postgres 컨테이너 계정. 앱도 같은 값으로 접속한다.
POSTGRES_DB=blanken
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# JWT 서명 키. HS256 기준 최소 32바이트 이상.  생성 예: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES_LONG_000000

# 소셜 로그인 (application-secret.yaml.example 참고)
KAKAO_CLIENT_ID=CHANGE_ME_KAKAO_CLIENT_ID
KAKAO_CLIENT_SECRET=CHANGE_ME_KAKAO_CLIENT_SECRET
NAVER_CLIENT_ID=CHANGE_ME_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=CHANGE_ME_NAVER_CLIENT_SECRET
