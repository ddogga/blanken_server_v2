# ──────────────────────────────────────────────────────────────────────────
# compose.prod.yaml 용 환경변수 **템플릿**. 이 파일은 커밋한다 (실제 값은 넣지 않는다).
#
# EC2 에서 사용법
#   cp .env.prod.example .env   # compose 는 같은 디렉터리의 .env 를 자동으로 읽는다
#   그 다음 CHANGE_ME 를 실제 값으로 바꾼다.
#
# ⚠️ 실제 값이 든 파일을 저장소에 두지 않는다. (.gitignore 는 `.env` 만 막는다 — `.env.prod` 같은 이름은 막히지 않는다)
# ──────────────────────────────────────────────────────────────────────────

# ECR 이미지 주소:태그 (커밋 SHA 태그 권장)
APP_IMAGE=CHANGE_ME.dkr.ecr.ap-northeast-2.amazonaws.com/blanken:CHANGE_ME_TAG

# RDS PostgreSQL
DB_URL=jdbc:postgresql://CHANGE_ME.rds.amazonaws.com:5432/blanken
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ElastiCache — 엔드포인트 주소만 (포트 제외)
REDIS_HOST=CHANGE_ME.cache.amazonaws.com
REDIS_PORT=6379
# 전송 중 암호화를 켠 클러스터(또는 Serverless)면 true
REDIS_SSL_ENABLED=false

# JWT 서명 키. HS256 기준 최소 32바이트 이상.  생성 예: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# 소셜 로그인 — 운영 도메인의 Redirect URI 를 카카오·네이버 콘솔에 등록해야 한다
#   https://<API 도메인>/blanken/login/oauth2/code/{kakao|naver}
KAKAO_CLIENT_ID=CHANGE_ME
KAKAO_CLIENT_SECRET=CHANGE_ME
NAVER_CLIENT_ID=CHANGE_ME
NAVER_CLIENT_SECRET=CHANGE_ME

# 프론트 주소 (쉼표로 여러 개 가능)
CORS_ALLOWED_ORIGINS=https://CHANGE_ME
OAUTH2_REDIRECT_SIGNUP=https://CHANGE_ME/signup
OAUTH2_REDIRECT_SUCCESS=https://CHANGE_ME/
OAUTH2_REDIRECT_FAILURE=https://CHANGE_ME/login
