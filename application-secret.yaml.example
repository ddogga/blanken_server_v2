# ──────────────────────────────────────────────────────────────────────────
# 로컬 개발용 시크릿 **템플릿**. 이 파일은 커밋한다 (실제 값은 넣지 않는다).
#
# 사용법
#   cp application-secret.yaml.example application-secret.yaml
#   그 다음 application-secret.yaml 의 CHANGE_ME 를 실제 값으로 바꾼다.
#   (application-secret.yaml 은 .gitignore 로 막혀 있다)
#
# application.yaml 의 `spring.config.import: optional:file:./application-secret.yaml`
# 이 이 파일을 읽어 들이고, 아래 키들이 `${KAKAO_CLIENT_ID}` 같은 플레이스홀더를 채운다.
# 키 이름을 환경변수와 똑같이 맞춰 둔 이유: 운영에서는 파일 없이 OS 환경변수만으로 동작해야 하기 때문.
# (OS 환경변수가 설정 파일보다 우선순위가 높으므로 운영 값이 항상 이긴다.)
#
# ⚠️ 반드시 **프로젝트 루트**에 둔다.
#    src/main/resources 에 두면 빌드 산출물(jar)에 패키징되어 시크릿이 유출된다.
#
# ⚠️ 값을 빈 문자열("")로 두지 말 것.
#    Spring Security 가 기동 중에 "Client id of registration 'kakao' must not be empty."
#    로 컨텍스트 로딩을 실패시킨다. 아직 모르는 값은 CHANGE_ME 상태로 둔다.
# ──────────────────────────────────────────────────────────────────────────

# 카카오 로그인 — https://developers.kakao.com → 내 애플리케이션 → 앱 키(REST API 키) / 보안
# Redirect URI 등록 필요: http://localhost:8080/login/oauth2/code/kakao
KAKAO_CLIENT_ID: "CHANGE_ME_KAKAO_CLIENT_ID"
KAKAO_CLIENT_SECRET: "CHANGE_ME_KAKAO_CLIENT_SECRET"

# 네이버 로그인 — https://developers.naver.com → 애플리케이션 → 내 애플리케이션
# Redirect URI 등록 필요: http://localhost:8080/login/oauth2/code/naver
NAVER_CLIENT_ID: "CHANGE_ME_NAVER_CLIENT_ID"
NAVER_CLIENT_SECRET: "CHANGE_ME_NAVER_CLIENT_SECRET"

# JWT 서명 키. HS256 기준 최소 32바이트 이상이어야 한다.
#   생성 예: openssl rand -base64 48
JWT_SECRET: "CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES_LONG_000000"

# 로컬 PostgreSQL 접속 정보.
# application.yaml 에 기본값(jdbc:postgresql://localhost:5432/blanken, user, 빈 비밀번호)이
# 들어 있으므로, 환경이 다를 때만 주석을 풀고 채운다.
# DB_URL: "jdbc:postgresql://localhost:5432/blanken"
# DB_USERNAME: "user"
# DB_PASSWORD: ""
